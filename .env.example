# Copy to .env (never commit .env). In production paste this into the Dokploy
# Compose service's Environment tab.

# ── Login ─────────────────────────────────────────────────────────────────────
ADMIN_USER=ruud
# bcrypt hash of the password: cd server && npm run hash-password
ADMIN_PASSWORD_HASH=$2b$12$replace-me-with-the-output-of-npm-run-hash-password
# Signs the session cookie; >= 32 random chars: openssl rand -base64 48
SESSION_SECRET=
# Cookie lifetime in days (default 7).
SESSION_TTL_DAYS=7

# ── Database (docker-compose.yml builds DATABASE_URL from this) ───────────────
POSTGRES_PASSWORD=
# Bare-metal dev against docker-compose.dev.yml instead:
# DATABASE_URL=postgresql://admin:admin@localhost:5433/admin?schema=website

# ── Portfolio site (the only cross-origin caller of the public routes) ────────
WEBSITE_URL=https://ruudjuffermans.nl
# Extra allowed origins, comma separated (dev defaults are added automatically).
# CORS_ORIGIN=https://ruudjuffermans.nl,https://www.ruudjuffermans.nl

# ── Contact form delivery ─────────────────────────────────────────────────────
CONTACT_EMAIL=ruudjuffermans@pm.me
MAIL_FROM=Ruud Juffermans <noreply@ruudjuffermans.nl>
# Without SMTP_HOST mails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Newsletter (Buttondown). "placeholder" = store signups locally only. ─────
NEWSLETTER_API_KEY=placeholder

# ── Digital twin admin API (server side only; never reaches the browser) ─────
# Compose service name on dokploy-network, or https://ai.ruudjuffermans.nl.
TWIN_API_URL=http://digital-twin-app-1:3000
# Must equal ADMIN_TOKEN in the twin's .env.
TWIN_ADMIN_TOKEN=

# ── Revault (revault.nl) admin API (server side only; never reaches the browser) ─
# Compose service name of the revault server on dokploy-network (docker ps
# shows it, e.g. revault-server-1:4000) or https://api.revault.nl.
REVAULT_API_URL=http://revault-server-1:4000
# Must equal ADMIN_SERVICE_TOKEN in the revault server's environment.
REVAULT_ADMIN_TOKEN=

# ── Funds ─────────────────────────────────────────────────────────────────────
# "Needs attention" when a provider's remaining credit drops below this (USD).
FUNDS_ALERT_USD=5

# ── Twin performance alerts (Overview "Needs attention", over the selected range) ─
# Time to first token p95 above this many ms, error rate or truncation rate
# (answers cut off at max_tokens) above these ratios.
TWIN_TTFT_P95_ALERT_MS=4000
TWIN_ERROR_RATE_ALERT=0.05
TWIN_TRUNCATION_RATE_ALERT=0.02

PORT=3000
